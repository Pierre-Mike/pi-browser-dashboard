{
  "name": "@pid/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev": "bun run dev:daemon & bun run dev:web & wait",
    "dev:daemon": "cd apps/daemon && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build:web:cli": "cd apps/web && bun run build",
    "build:cli": "bun run build:web:cli && rm -rf apps/cli/dist-web && cp -R apps/web/dist apps/cli/dist-web && cd apps/cli && bun run build",
    "start:cli": "bun run build:cli && bun apps/cli/dist/main.js",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "typecheck": "bun run scripts/typecheck.ts",
    "test": "bun run scripts/check-colocated-tests.ts && bun run scripts/check-harness.ts && bun run vocabulary && bun run test:daemon && bun run test:shared && bun run test:scripts && bun run test:evals",
    "test:daemon": "cd apps/daemon && bun test",
    "test:shared": "cd shared && bun test",
    "test:scripts": "bun test ./scripts",
    "test:evals": "bun test ./evals",
    "test:web": "cd apps/web && bun test",
    "test:cli": "cd apps/cli && bun test",
    "test:e2e": "cd apps/e2e && bun run test",
    "test:e2e:ui": "cd apps/e2e && bun run test:ui",
    "test:e2e:setup-auth": "cd apps/e2e && bun run setup:auth",
    "test:mutation": "bunx stryker run",
    "audit": "fallow audit --health-baseline .fallow-baselines/health.json --dupes-baseline .fallow-baselines/dupes.json",
    "dead-code": "fallow dead-code",
    "doctor": "bun run scripts/check-harness.ts",
    "vocabulary": "bun run scripts/check-vocabulary.ts --all",
    "vocabulary:list": "bun run scripts/check-vocabulary.ts --list",
    "axiom-debt": "bun run scripts/check-axiom-debt.ts",
    "axiom-debt:update": "bun run scripts/check-axiom-debt.ts --update",
    "check:feature-tests": "./scripts/check-feature-tests.sh",
    "scaffold:slice": "bun run scripts/scaffold-slice.ts",
    "scaffold:theme": "bun run scripts/scaffold-theme.ts",
    "theme:check": "bun run scripts/theme-check.ts",
    "evals": "./evals/run.sh",
    "evals:baseline": "bun run evals/run.ts --baseline --suite full",
    "evals:report": "bun run evals/report.ts",
    "verify": "bun run lint:ci && bun run typecheck && bun run test && bun run test:web && bun run test:cli && bun run audit && bun run axiom-debt",
    "pid-ext": "bun run scripts/pid-ext.ts",
    "pid-promote": "bun run scripts/pid-promote.ts",
    "prepare": "git config --unset core.hooksPath 2>/dev/null; bunx lefthook install || true",
    "audit:baseline": "fallow health --save-baseline .fallow-baselines/health.json; fallow dupes --save-baseline .fallow-baselines/dupes.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "fallow": "^2.88.1",
    "lefthook": "^2.1.3",
    "playwright": "^1.61.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@babel/code-frame": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.7",
    "@babel/helper-globals": "^7.29.7",
    "@babel/helper-string-parser": "^7.29.7",
    "@babel/helper-validator-identifier": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/template": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7"
  }
}
